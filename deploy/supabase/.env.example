############

############
# Secrets — ALL MUST BE FRESHLY GENERATED (do not copy from dev)
############

POSTGRES_PASSWORD=<GENERATED>

JWT_SECRET=<GENERATED>
ANON_KEY=<GENERATED>
SERVICE_ROLE_KEY=<GENERATED>

DASHBOARD_USERNAME=dschoepel
DASHBOARD_PASSWORD=<GENERATED>

SECRET_KEY_BASE=<GENERATED>
VAULT_ENC_KEY=<GENERATED>
PG_META_CRYPTO_KEY=<GENERATED>

LOGFLARE_PUBLIC_ACCESS_TOKEN=<GENERATED>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<GENERATED>

S3_PROTOCOL_ACCESS_KEY_ID=stub
S3_PROTOCOL_ACCESS_KEY_SECRET=stub


############
# URLs — Production values
############

# Public URL of the Supabase Kong gateway (used by browser and Studio)
SUPABASE_PUBLIC_URL=https://supabase.ptraker.com

# Full external URL of the Auth service (used to construct OAuth callbacks, email links)
API_EXTERNAL_URL=https://supabase.ptraker.com


############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5434


############
# Supavisor — Connection pooler
############

POOLER_PROXY_PORT_TRANSACTION=6544
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=<GENERATED>
POOLER_DB_POOL_SIZE=5


############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=ptraker
STUDIO_DEFAULT_PROJECT=ptraker
OPENAI_API_KEY=


############
# Auth
############

# Production site URL — where users land after auth flows
SITE_URL=https://ptraker.com

# Allowed redirect URLs after auth (add any additional origins here)
ADDITIONAL_REDIRECT_URLS=https://ptraker.com

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false   # MUST remain false — ptraker sends all auth emails manually via generateLink

SMTP_ADMIN_EMAIL=ptraker@theschoepels.com
SMTP_HOST=theschoepels-com-smtp.dynu.com
SMTP_PORT=587
SMTP_USER=dave@theschoepels.com
SMTP_PASS=<CHANGE_ME>
SMTP_SENDER_NAME=portfolioTraker

ENABLE_ANONYMOUS_USERS=false
GOTRUE_MAILER_EXTERNAL_HOSTS=

ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=stub
GOOGLE_SECRET=stub


############
# Storage — local file backend (no S3)
############

GLOBAL_S3_BUCKET=ptraker-storage
REGION=stub
STORAGE_TENANT_ID=stub


############
# PostgREST
############

PGRST_DB_SCHEMAS=public,storage,graphql_public


############
# Analytics
############

DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER


############
# Kong — ports kept for reference but NOT bound to host in production compose
############

KONG_HTTP_PORT=8100
KONG_HTTPS_PORT=8444


############
# imgproxy
############

IMGPROXY_ENABLE_WEBP_DETECTION=true
