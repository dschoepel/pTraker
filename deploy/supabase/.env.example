#       elif isinstance(d, str): d = d.encode()
#       return base64.urlsafe_b64encode(d).rstrip(b'=').decode()
#   def jwt(p):
#       h=b64u({'alg':'HS256','typ':'JWT'}); pl=b64u(p); m=f'{h}.{pl}'
#       s=base64.urlsafe_b64encode(hmac.new(jwt_secret.encode(),m.encode(),hashlib.sha256).digest()).rstrip(b'=').decode()
#       return f'{m}.{s}'
#   print(f'JWT_SECRET={jwt_secret}')
#   print(f'ANON_KEY={jwt({"role":"anon","iss":"supabase","iat":now,"exp":exp})}')
#   print(f'SERVICE_ROLE_KEY={jwt({"role":"service_role","iss":"supabase","iat":now,"exp":exp})}')
#   print(f'POSTGRES_PASSWORD={secrets.token_urlsafe(24)}')
#   print(f'SECRET_KEY_BASE={secrets.token_urlsafe(64)}')
#   print(f'VAULT_ENC_KEY={secrets.token_urlsafe(32)}')
