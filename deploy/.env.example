############
# ptraker — Production App Environment
# Jupiter VPS (142.202.190.9)
#
# SETUP:
#   1. Copy this file to /data/ptraker/.env
#   2. Fill in SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY (from Step 4 — generate-secrets.py output)
#   3. Fill in SMTP_PASS
############

############
# Supabase — internal connection via Kong (container name on proxy_net)
############

SUPABASE_URL=http://ptraker-supabase-kong:8000
SUPABASE_ANON_KEY=<from generate-secrets.py ANON_KEY>
SUPABASE_SERVICE_KEY=<from generate-secrets.py SERVICE_ROLE_KEY>

############
# Email — SMTP via theschoepels.com relay
############

SMTP_HOST=theschoepels-com-smtp.dynu.com
SMTP_PORT=587
SMTP_USER=dave@theschoepels.com
SMTP_PASS=<CHANGE_ME>
SMTP_SENDER_NAME=portfolioTraker
SMTP_FROM_EMAIL=ptraker@theschoepels.com

############
# Price refresh cron — weekdays at 5pm CT (after NYSE close)
# Default if omitted: 0 17 * * 1-5
############

PRICE_REFRESH_CRON=0 17 * * 1-5
